
name: EAS Build (AAB + APK + GitHub Release)

on:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 18

      - name: Install EAS CLI
        run: npm install -g eas-cli

      - name: Install dependencies
        run: npm ci

      - name: Login to EAS
        env:
          EAS_TOKEN: ${{ secrets.EAS_TOKEN }}
        run: eas login --token "${{ secrets.EAS_TOKEN }}"

      - name: Build AAB
        run: |
          eas build --platform android --profile production --non-interactive
          eas build:list --platform android > build_list.txt

      - name: Build APK
        run: |
          eas build --platform android --profile preview --non-interactive
          eas build:list --platform android >> build_list.txt

      - name: Upload artifact list
        uses: actions/upload-artifact@v4
        with:
          name: build-list
          path: build_list.txt

      - name: Create Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v${{ github.run_number }}
          name: "BARPUS99 Mobile Build #${{ github.run_number }}"
          body: "Auto release by GitHub Actions. Download APK/AAB from EAS dashboard."
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
